# 1. PostgreSQL Database URL (Railway / Supabase / Neon / Local)
DATABASE_URL=postgresql://postgres:password@host:port/database

# 2. Email Notification (SMTP - contoh menggunakan Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=emailanda@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="Invoicely Billing" <emailanda@gmail.com>

# 3. Kunci Rahasia Pengaman Cron Job Webhook
CRON_SECRET=invoicely_cron_secret
